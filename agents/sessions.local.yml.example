    worktree_path: "<填入本机 Worktree 绝对路径>"
    current_session_id: "engineering-agent-b"
  EVENT_AGENT_C:
    worktree_path: "<填入本机 Worktree 绝对路径>"
    current_session_id: "event-agent-c"
  WORKBENCH_AGENT_D:
    worktree_path: "<填入本机 Worktree 绝对路径>"
    current_session_id: "product-agent-d"
