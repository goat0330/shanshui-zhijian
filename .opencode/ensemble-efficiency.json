{
  "version": 1,
  "base_branch": "integration/g0-g1-contract-freeze",
  "routes": [
    {
      "name": "perception",
      "owner": "perception-agent-a",
      "paths": [
        "ml/**",
        "tools/**",
        "core/schemas/contracts/candidate.py",
        "core/schemas/contracts/perception.py",
        "tests/test_ml_b2.py",
        "tests/test_candidate*.py"
      ],
      "checks": []
    },
    {
      "name": "engineering",
      "owner": "engineering-agent-b",
      "paths": [
        ".github/**",
        "competition/**",
        "core/schemas/contracts/run_manifest*",
        "core/schemas/contracts/sar_metadata*",
        "apps/workbench_api/manifest_service.py",
        "tests/test_run_manifest*.py",
        "tests/test_competition*.py"
      ],
      "checks": []
    },
    {
      "name": "event-governance",
      "owner": "event-agent-c",
      "paths": [
        "core/event_governance/**",
        "core/schemas/contracts/event*",
        "core/schemas/contracts/evidence*",
        "core/schemas/contracts/review*",
        "core/schemas/contracts/replay*",
        "services/**",
        "tests/test_event*.py",
        "tests/test_evidence*.py",
        "tests/test_review*.py",
        "tests/test_replay*.py"
      ],
      "checks": []
    },
    {
      "name": "product",
      "owner": "product-agent-d",
      "paths": [
        "frontend/**",
        "apps/workbench_api/**",
        "docs/program/ACCEPTANCE*"
      ],
      "checks": []
    },
    {
      "name": "control-plane",
      "owner": "project-manager-agent-e",
      "paths": [
        ".opencode/**",
        ".agent/**",
        "agent-control-plane/**",
        "agent-control-plane_LUBAN_AUDIT*.md",
        ".codegraph/**",
        "AGENTS.md",
        "README.md",
        "agents/**",
        "docs/program/STATUS_BOARD.md",
        "docs/program/DECISION_LOG.md",
        "docs/program/CONTRACT_GAP_REGISTER.md",
        ".gitignore",
        "pyproject.toml",
        "scripts/**",
        "tests/**",
        "apps/__init__.py",
        "competition/__init__.py",
        "services/__init__.py"
      ],
      "checks": []
    },
    {
      "name": "default",
      "owner": "project-manager-agent-e",
      "paths": [
        "**"
      ],
      "checks": []
    }
  ],
  "minimum_checks": {},
  "escalate": [
    {
      "name": "agent-runtime",
      "paths": [
        ".opencode/**",
        ".agent/**",
        "**/opencode.json",
        "**/opencode.jsonc",
        "**/AGENTS.md"
      ],
      "reason": "Agent runtime, permissions, prompts, skills, or startup configuration changed"
    },
    {
      "name": "public-contract",
      "paths": [
        "core/schemas/contracts/**",
        "contracts/**",
        "**/openapi.*"
      ],
      "reason": "Public contract or shared schema changed"
    }
  ],
  "limits": {
    "max_files_without_escalation": 25,
    "max_changed_lines_without_escalation": 800,
    "max_routes_without_escalation": 1,
    "success_excerpt_lines": 5,
    "failure_excerpt_lines": 36,
    "command_timeout_sec": 300
  }
}
