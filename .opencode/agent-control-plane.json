{
  "version": 1,
  "context": {
    "version": 1,
    "state_dir": ".agent/context",
    "reports_dir": ".agent/reports",
    "artifacts_dir": ".agent/artifacts",
    "stable_files": [
      "AGENTS.md",
      "agents/sessions.yml",
      "STATUS_BOARD.md",
      ".opencode/agent-control-plane.json"
    ],
    "limits": {
      "soft_messages": 80,
      "hard_messages": 120,
      "soft_session_mb": 15,
      "hard_session_mb": 25,
      "soft_input_tokens": 2000000,
      "hard_input_tokens": 3500000,
      "max_full_file_bytes": 200000,
      "max_excerpt_lines": 100,
      "max_report_input_lines": 80,
      "max_report_output_lines": 12,
      "max_result_items": 5,
      "max_blocker_items": 3,
      "max_bootstrap_lines": 80
    },
    "domain_paths": {
      "agent-a": ["ml/**", "core/schemas/contracts/**", "tests/test_ml_*.py"],
      "agent-b": [".github/**", "requirements*.txt", "pyproject.toml", "apps/workbench_api/manifest_service.py"],
      "agent-c": ["core/event_governance/**", "apps/workbench_api/real_service.py"],
      "agent-d": ["frontend/**", "docs/program/ACCEPTANCE_*.md"],
      "agent-e": [".agent/**", ".opencode/**", "AGENTS.md", "STATUS_BOARD.md", "agents/sessions.yml"]
    },
    "compaction": {
      "enabled": false,
      "command": []
    }
  },
  "routes": [
    {
      "name": "perception",
      "owner": "perception-agent-a",
      "paths": ["ml/**"],
      "checks": [
        {
          "name": "perception-smoke",
          "command": [
            "python",
            "-c",
            "from pathlib import Path; import compileall; p=Path('ml'); assert p.is_dir(), 'ml directory is missing'; assert compileall.compile_dir(str(p), quiet=1), 'ml compilation failed'"
          ],
          "timeout_sec": 30
        }
      ]
    },
    {
      "name": "engineering",
      "owner": "engineering-agent-b",
      "paths": ["competition/**"],
      "checks": [
        {
          "name": "engineering-smoke",
          "command": ["python", "-m", "compileall", "-q", "competition"],
          "timeout_sec": 30
        }
      ]
    },
    {
      "name": "event-governance",
      "owner": "event-agent-c",
      "paths": ["core/event_governance/**"],
      "checks": [
        {
          "name": "event-smoke",
          "command": ["python", "-m", "compileall", "-q", "core/event_governance"],
          "timeout_sec": 30
        }
      ]
    },
    {
      "name": "product",
      "owner": "product-agent-d",
      "paths": ["frontend/**"],
      "checks": [
        {
          "name": "product-smoke",
          "command": [
            "python",
            "-c",
            "from pathlib import Path; p=Path('frontend'); assert p.is_dir(), 'frontend directory is missing'"
          ],
          "timeout_sec": 30
        }
      ]
    },
    {
      "name": "control-plane",
      "owner": "project-manager-agent-e",
      "paths": [
        ".opencode/**",
        ".agent/**",
        ".codegraph/**",
        "agent-control-plane/**",
        "agent-control-plane_LUBAN_AUDIT*"
      ],
      "checks": [
        {
          "name": "control-plane-smoke",
          "command": [
            "python",
            "C:/Users/WangChi/.agents/skills/agent-control-plane/scripts/test_acp.py"
          ],
          "timeout_sec": 30
        }
      ]
    },
    {
      "name": "default",
      "owner": "project-manager-agent-e",
      "paths": ["**"],
      "checks": []
    }
  ],
  "escalate": [
    {
      "name": "agent-runtime",
      "paths": [
        ".opencode/**",
        ".agent/**",
        "**/opencode.json",
        "**/opencode.jsonc",
        "**/AGENTS.md"
      ],
      "reason": "Agent runtime, permissions, prompts, skills, or startup configuration changed"
    },
    {
      "name": "public-contract",
      "paths": [
        "contracts/**",
        "**/schema/**",
        "**/schemas/**",
        "**/openapi.*",
        "**/api/**/types.*"
      ],
      "reason": "Public contract or shared schema changed"
    }
  ],
  "limits": {
    "max_files_without_escalation": 25,
    "max_changed_lines_without_escalation": 800,
    "max_routes_without_escalation": 1,
    "success_excerpt_lines": 5,
    "failure_excerpt_lines": 36,
    "command_timeout_sec": 300
  },
  "minimum_checks": {
    "perception": ["perception-smoke"],
    "engineering": ["engineering-smoke"],
    "event-governance": ["event-smoke"],
    "product": ["product-smoke"],
    "control-plane": ["control-plane-smoke"]
  }
}
